# ──────────────────────────────────────────────────────────────────────────────
# BOOKKEEPING CLEAN-UP AGENT — Environment Variables
# Copy to .env and fill real credentials. NEVER commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# LLM (optional — only if EXTRACTION_MODE=cloud)
OPENAI_API_KEY=sk-proj-...

# Audio Transcription (optional)
GROQ_API_KEY=gsk_...

# PDF Extraction (optional — cloud mode)
LLAMAPARSE_API_KEY=llx-...

# Default: local/free parsers (pdfplumber + CoA rules). Use cloud for paid APIs.
EXTRACTION_MODE=local

# Supabase — PostgreSQL + pgvector
# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role (secret) — NOT the anon key
# Optional: JWT Secret for HS256 verify (Dashboard → API → JWT Secret). Else API uses JWKS.
# SUPABASE_JWT_SECRET=
# Optional direct Postgres URL (Dashboard → Database → Connection string)
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Auth — leave false for local demos; set true on public Render (see docs/AUTH.md)
AUTH_ENABLED=false
# ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://ledgerai-0wyy.onrender.com,http://localhost:5173

# Frontend (Vite) — when both set, /app/* requires login
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...   # anon / publishable — never service_role
# VITE_API_URL=

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_CURRENCY=USD
FISCAL_YEAR_START_MONTH=1

# Google Drive (optional — upload web works without these)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# ── FASE 2 — QuickBooks (keep commented until accounting is closed) ───────────
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REDIRECT_URI=http://localhost:8000/qb/callback
# QUICKBOOKS_ENVIRONMENT=sandbox
