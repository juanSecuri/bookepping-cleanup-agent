# ──────────────────────────────────────────────────────────────────────────────
# BOOKKEEPING CLEAN-UP AGENT — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# LLM & Vision (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Audio Transcription (Groq Cloud — whisper-large-v3)
GROQ_API_KEY=gsk_...

# PDF / Bank-Statement Extraction (LlamaParse)
LLAMAPARSE_API_KEY=llx-...

# Cross-analysis / Embeddings (OpenAI)
OPENAI_API_KEY=sk-proj-...

# Supabase — PostgreSQL + pgvector
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# QuickBooks Online (Intuit Developer)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/qb/callback
QUICKBOOKS_ENVIRONMENT=sandbox   # or "production"

# Application
APP_ENV=development
LOG_LEVEL=INFO
