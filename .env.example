# ──────────────────────────────────────────────────────────────────────────────
# BOOKKEEPING CLEAN-UP AGENT — Environment Variables
# Copy to .env and fill real credentials. NEVER commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# LLM (OpenAI — vision, structuring, embeddings)
OPENAI_API_KEY=sk-proj-...

# Audio Transcription (Groq Whisper)
GROQ_API_KEY=gsk_...

# PDF Extraction (LlamaParse)
LLAMAPARSE_API_KEY=llx-...

# Supabase — PostgreSQL + pgvector
# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role (secret) — NOT the anon key
# Optional direct Postgres URL (Dashboard → Database → Connection string)
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_CURRENCY=USD
FISCAL_YEAR_START_MONTH=1

# ── FASE 2 — QuickBooks (keep commented until accounting is closed) ───────────
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REDIRECT_URI=http://localhost:8000/qb/callback
# QUICKBOOKS_ENVIRONMENT=sandbox
